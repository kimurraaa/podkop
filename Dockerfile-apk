FROM itdoginfo/openwrt-sdk-apk:25.12.3

ARG PODKOP_VERSION
ENV PODKOP_VERSION=${PODKOP_VERSION}

COPY ./podkop /builder/package/feeds/utilities/podkop-orbit
COPY ./luci-app-podkop /builder/package/feeds/luci/luci-app-podkop-orbit

RUN make defconfig && \
    make package/podkop-orbit/compile -j4 V=s && \
    make package/luci-app-podkop-orbit/compile -j4 V=s
